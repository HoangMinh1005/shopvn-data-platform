# Copy to .env and fill with the credentials provided with the dataset.
# These values do not rotate credentials baked into the source images.
COMPOSE_PROJECT_NAME=shopvn-sources
SHOPVN_SOURCE_PLATFORM=linux/arm64
SHOPVN_DB_NAME=shopvn
SHOPVN_DB_ADMIN_USER=postgres
SHOPVN_DB_ADMIN_PASSWORD=replace-with-provided-demo-value
SHOPVN_DB_READER_USER=shopvn_reader
SHOPVN_DB_READER_PASSWORD=replace-with-provided-demo-value
SHOPVN_DB_HOST_PORT=5434
SHOPVN_API_HOST_PORT=8000
SHOPVN_SFTP_HOST_PORT=2222
SHOPVN_LOGISTICS_API_KEY=replace-with-provided-demo-value
SHOPVN_SFTP_USER=marketplace_reader
SHOPVN_SFTP_PASSWORD=replace-with-provided-demo-value

# Isolated lakehouse readiness spike; use separate local credentials.
SPIKE_DB_PASSWORD=replace-with-a-local-password
SPIKE_MINIO_USER=shopvn-readiness
SPIKE_MINIO_PASSWORD=replace-with-a-local-password

# Generated locally by scripts/bootstrap_airflow.py. Leave empty in a real .env
# before bootstrap; these placeholders are only for Compose validation in CI.
AIRFLOW_DB_PASSWORD=replace-with-generated-local-value
AIRFLOW_JWT_SECRET=replace-with-generated-local-value
AIRFLOW_API_SECRET=replace-with-generated-local-value
AIRFLOW_FERNET_KEY=replace-with-generated-local-value
AIRFLOW_ADMIN_PASSWORD=replace-with-generated-local-value
GRAFANA_ADMIN_PASSWORD=replace-with-generated-local-value
MONITOR_START_DATE=replace-with-generated-local-value
INVENTORY_GO_LIVE_DATE=replace-with-first-observation-date
