{
  "uid": "shopvn-operations",
  "title": "ShopVN — Pipeline & Data Quality",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "timezone": "Asia/Ho_Chi_Minh",
  "time": {"from": "now-6h", "to": "now"},
  "tags": ["shopvn", "finance", "operations"],
  "panels": [
    {"id":1,"type":"text","title":"Phạm vi","gridPos":{"x":0,"y":0,"w":24,"h":3},"options":{"mode":"markdown","content":"**Direct + marketplace Finance / actual inventory / local.** Orders và marketplace mẫu chỉ có tháng 6/2026; tháng thiếu file phải có nhãn partial. Inventory là quan sát thật từ go-live; EOD trong cửa sổ 60 giây, không exact stock tại 00:00. Ngày xử lý khác ngày nghiệp vụ; job xanh không chứng minh November D−1 freshness. Cảnh báo local, chưa email/Slack."}},
    {"id":2,"type":"stat","title":"Latest workflow SUCCESS","gridPos":{"x":0,"y":3,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_pipeline_state{state=\"success\"}","refId":"A"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"1":{"text":"SUCCESS","color":"green"},"0":{"text":"RUNNING / FAILED","color":"orange"}}}]},"overrides":[]},"options":{"colorMode":"background","reduceOptions":{"calcs":["lastNotNull"]}}},
    {"id":3,"type":"stat","title":"Last completion time","gridPos":{"x":6,"y":3,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_pipeline_last_finish_timestamp_seconds * 1000","refId":"A"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"},"overrides":[]}},
    {"id":4,"type":"stat","title":"Requested business date","gridPos":{"x":12,"y":3,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_business_date_timestamp_seconds * 1000","refId":"A"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"},"overrides":[]}},
    {"id":5,"type":"stat","title":"Source data through","gridPos":{"x":18,"y":3,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_source_end_date_timestamp_seconds * 1000","refId":"A"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"},"overrides":[]}},
    {"id":6,"type":"timeseries","title":"Service health — 1 healthy / 0 unhealthy","gridPos":{"x":0,"y":7,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_service_up","legendFormat":"{{service}}","refId":"A"}],"fieldConfig":{"defaults":{"min":0,"max":1},"overrides":[]}},
    {"id":7,"type":"timeseries","title":"FIN02 — requested business date, source vs candidate (VND)","gridPos":{"x":12,"y":7,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_fin02_amount_vnd","legendFormat":"{{layer}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"currencyVND"},"overrides":[]}},
    {"id":8,"type":"stat","title":"Reconciliation delta — must be 0 VND","gridPos":{"x":0,"y":14,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_fin02_delta_vnd","refId":"A"}],"fieldConfig":{"defaults":{"unit":"currencyVND","decimals":2},"overrides":[]}},
    {"id":9,"type":"stat","title":"DQ gate passed","gridPos":{"x":6,"y":14,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_pipeline_dq_passed","refId":"A"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"1":{"text":"PASS","color":"green"},"0":{"text":"NOT PASSED","color":"red"}}}]},"overrides":[]},"options":{"colorMode":"background"}},
    {"id":10,"type":"stat","title":"08:00 Vietnam deadline missed","gridPos":{"x":12,"y":14,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_daily_deadline_missed","refId":"A"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"NO","color":"green"},"1":{"text":"MISSED","color":"red"}}}]},"overrides":[]}},
    {"id":11,"type":"stat","title":"Latest workflow FAILED","gridPos":{"x":18,"y":14,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_pipeline_state{state=\"failed\"}","refId":"A"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"NO","color":"green"},"1":{"text":"FAILED","color":"red"}}}]},"overrides":[]}},
    {"id":12,"type":"timeseries","title":"Unresolved persisted alerts","gridPos":{"x":0,"y":18,"w":12,"h":6},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_open_alerts","legendFormat":"{{kind}}","refId":"A"}]},
    {"id":13,"type":"timeseries","title":"Prometheus firing alerts","gridPos":{"x":12,"y":18,"w":12,"h":6},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"ALERTS{alertstate=\"firing\"}","legendFormat":"{{alertname}} {{service}}","refId":"A"}]},
    {"id":14,"type":"stat","title":"Inventory — actual observation time","gridPos":{"x":0,"y":24,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_inventory_observed_timestamp_seconds * 1000","refId":"A"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"},"overrides":[]}},
    {"id":15,"type":"stat","title":"Inventory — current total stock (not historical sum)","gridPos":{"x":6,"y":24,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_inventory_stock_qty","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"id":16,"type":"stat","title":"Inventory — last actual EOD business date","gridPos":{"x":12,"y":24,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_inventory_eod_date_timestamp_seconds * 1000","refId":"A"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"},"overrides":[]}},
    {"id":17,"type":"stat","title":"Inventory — capture lag from midnight (seconds)","gridPos":{"x":18,"y":24,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_inventory_capture_lag_seconds","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":18,"type":"stat","title":"Inventory — EOD missing after 00:10 VN","gridPos":{"x":0,"y":28,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_inventory_eod_missing","refId":"A"}],"fieldConfig":{"defaults":{"unit":"none"},"overrides":[]}},
    {"id":19,"type":"stat","title":"Inventory — latest workflow FAILED","gridPos":{"x":6,"y":28,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_inventory_failed","refId":"A"}],"fieldConfig":{"defaults":{"unit":"none"},"overrides":[]}},
    {"id":20,"type":"timeseries","title":"Marketplace — requested file coverage (not all historic files)","gridPos":{"x":0,"y":32,"w":12,"h":6},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_file_count","legendFormat":"{{state}}","refId":"A"}]},
    {"id":21,"type":"stat","title":"Marketplace — latest workflow FAILED","gridPos":{"x":12,"y":32,"w":6,"h":6},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_failed","refId":"A"}]},
    {"id":22,"type":"stat","title":"Marketplace — all-partner requested scope complete","gridPos":{"x":18,"y":32,"w":6,"h":6},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_complete","refId":"A"}]},
    {"id":23,"type":"stat","title":"Marketplace — reported net, active published scope (VND)","gridPos":{"x":0,"y":38,"w":8,"h":5},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_reported_net_vnd","refId":"A"}],"fieldConfig":{"defaults":{"unit":"currencyVND"},"overrides":[]}},
    {"id":24,"type":"stat","title":"Marketplace — reconciliation delta / NaN unchecked","gridPos":{"x":8,"y":38,"w":8,"h":5},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_reconciliation_delta_vnd","refId":"A"}],"fieldConfig":{"defaults":{"unit":"currencyVND"},"overrides":[]}},
    {"id":25,"type":"stat","title":"Marketplace — current D-1 deadline missed","gridPos":{"x":16,"y":38,"w":8,"h":5},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_deadline_missed","refId":"A"}]},
    {"id":26,"type":"timeseries","title":"Marketplace — active rows / status exclusions / formula warnings","gridPos":{"x":0,"y":43,"w":16,"h":6},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_row_count","legendFormat":"{{kind}}","refId":"A"}]},
    {"id":27,"type":"stat","title":"Marketplace — DQ gate passed / NaN unchecked","gridPos":{"x":16,"y":43,"w":8,"h":6},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_gate_passed","refId":"A"}]},
    {"id":28,"type":"stat","title":"Marketplace — requested business start date","gridPos":{"x":0,"y":49,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_business_date_timestamp_seconds{boundary=\"start\"} * 1000","refId":"A"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"},"overrides":[]}},
    {"id":29,"type":"stat","title":"Marketplace — requested business end date","gridPos":{"x":6,"y":49,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_business_date_timestamp_seconds{boundary=\"end\"} * 1000","refId":"A"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"},"overrides":[]}},
    {"id":30,"type":"stat","title":"Marketplace — capture completed at (processing clock)","gridPos":{"x":12,"y":49,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_capture_completed_timestamp_seconds * 1000","refId":"A"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"},"overrides":[]}},
    {"id":31,"type":"stat","title":"Marketplace — last successful publication check (may be partial)","gridPos":{"x":18,"y":49,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"shopvn-prometheus"},"targets":[{"expr":"shopvn_marketplace_last_publication_check_timestamp_seconds * 1000","refId":"A"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"},"overrides":[]}}
  ]
}
